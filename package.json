{
  "name": "aurora-travel",
  "version": "1.0.0",
  "private": true,
  "description": "Aurora travel website project with custom CSS and JS build pipeline",
  "author": "Kamil Król — KP_Code Digital Studio",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KPKrol85/DS-hospitality-pr02-Aurora.git"
  },
  "homepage": "https://ds-hospitality-pr02-aurora.netlify.app/",
  "scripts": {
    "test": "vitest run",
    "clean": "node scripts/clean-dist.js",
    "images:bootstrap": "node scripts/images-bootstrap.js",
    "build:images": "node scripts/build-images.js",
    "build:stage": "node scripts/build-dist.js",
    "build:css": "postcss css/style.css -o dist/css/style.min.css && npm run verify:css",
    "build:js": "esbuild js/script.js --bundle --minify --target=es2018 --define:__AURORA_PRODUCTION__=true --outfile=dist/js/script.min.js && npm run verify:js",
    "verify:css": "node scripts/verify-built-css.js",
    "verify:js": "node scripts/verify-built-js.js",
    "watch:css": "postcss css/style.css -o dist/css/style.min.css --watch",
    "watch:js": "esbuild js/script.js --bundle --minify --target=es2018 --define:__AURORA_PRODUCTION__=true --outfile=dist/js/script.min.js --watch",
    "preview:source": "node scripts/preview-server.js source",
    "preview:dist": "node scripts/preview-server.js dist",
    "check:css-assets": "node scripts/check-css-assets.js",
    "check:assets": "node scripts/check-asset-integrity.js",
    "check:assets:dist": "node scripts/check-asset-integrity.js --dist",
    "check:csp": "node scripts/check-csp.js",
    "check:csp:dist": "node scripts/check-csp.js --dist",
    "check:tour-catalogue": "node scripts/check-tour-catalogue.js",
    "check:sw-bundles": "node scripts/check-sw-bundles.js",
    "record:sw-bundles": "node scripts/check-sw-bundles.js --record",
    "build": "npm run clean && npm run build:stage && npm run build:css && npm run build:js && npm run check:css-assets && npm run check:assets && npm run check:assets:dist && npm run check:csp && npm run check:csp:dist && npm run check:tour-catalogue && npm run check:sw-bundles",
    "dist": "npm run build",
    "predeploy:check": "npm test && npm run build"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.10.8",
    "cssnano": "^7.1.2",
    "esbuild": "^0.27.4",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "sharp": "^0.34.5",
    "vitest": "^5.0.2"
  }
}
